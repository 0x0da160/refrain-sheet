{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Canvas colours for the \"dark\" app theme.",
  "canvas": {
    "$type": "color",
    "canvas-bg": {
      "$value": "{color.ink.950}",
      "$description": "Cell background; also source-editor background"
    },
    "canvas-row-alt-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0784,
          0.102,
          0.1333
        ],
        "alpha": 0.5,
        "hex": "#141a22"
      },
      "$description": "Banded rows, light strength (the default); drawn over canvas-bg"
    },
    "canvas-row-alt": {
      "$value": "{color.ink.900}",
      "$description": "Banded rows, medium strength (bands are off by default)"
    },
    "canvas-row-alt-strong": {
      "$value": "{color.ink.800}",
      "$description": "Banded rows, dark strength"
    },
    "canvas-header-bg": {
      "$value": "{color.ink.800}",
      "$description": "Row and column headers; darker than every band"
    },
    "canvas-header-text": {
      "$value": "{color.ink.150}"
    },
    "canvas-header-selected-bg": {
      "$value": "{color.green.900}",
      "$description": "Header of a selected row/column"
    },
    "canvas-header-selected-text": {
      "$value": "{color.green.200}"
    },
    "canvas-grid": {
      "$value": "{color.ink.700}",
      "$description": "Grid lines"
    },
    "canvas-grid-strong": {
      "$value": "{color.ink.600}",
      "$description": "Header edge lines, and the lines between headers"
    },
    "canvas-outside": {
      "$value": "{color.ink.1000}",
      "$description": "Area past the last row and column"
    },
    "canvas-frozen-divider": {
      "$value": "{color.ink.350}",
      "$description": "Line after frozen rows/columns"
    },
    "canvas-text": {
      "$value": "{color.paper.50}",
      "$description": "Cell text in the default style"
    },
    "canvas-text-muted": {
      "$value": "{color.ink.150}",
      "$description": "Placeholder and secondary text inside the canvas"
    },
    "canvas-selection": {
      "$value": "{color.green.900}",
      "$description": "Solid selection fill (single items)"
    },
    "canvas-range-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5451,
          0.7569,
          0.5686
        ],
        "alpha": 0.16,
        "hex": "#8bc191"
      },
      "$description": "Selected range: translucent, so user cell fills stay visible"
    },
    "canvas-selection-border": {
      "$value": "{color.green.300}",
      "$description": "Active cell border, range edge, fill handle"
    },
    "canvas-focus-ring": {
      "$value": "{color.green.300}",
      "$description": "Focus outline drawn on the canvas"
    },
    "canvas-find-match": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5255,
          0.349,
          0
        ],
        "alpha": 0.55,
        "hex": "#865900"
      },
      "$description": "Find: every match"
    },
    "canvas-find-current": {
      "$value": "{color.amber.300}",
      "$description": "Find: outline of the current match"
    },
    "canvas-error-text": {
      "$value": "{color.red.300}",
      "$description": "Formula error values (#DIV/0! etc.), bold"
    },
    "canvas-formula-text": {
      "$value": "{color.green.300}",
      "$description": "Text of a cell whose value is computed"
    },
    "canvas-formula-mark": {
      "$value": "{color.green.400}",
      "$description": "Formula corner mark (bottom-left)"
    },
    "canvas-edited-mark": {
      "$value": "{color.amber.500}",
      "$description": "Edited-cell change bar (inline-start edge)"
    },
    "canvas-comment-mark": {
      "$value": "{color.blue.300}",
      "$description": "Comment corner mark (top-right)"
    },
    "state-added": {
      "$value": "{color.green.900}",
      "$description": "Diff: added"
    },
    "state-added-text": {
      "$value": "{color.green.200}"
    },
    "state-modified": {
      "$value": "{color.amber.900}",
      "$description": "Diff / unsaved edit: modified"
    },
    "state-modified-text": {
      "$value": "{color.amber.300}"
    },
    "state-removed": {
      "$value": "{color.red.900}",
      "$description": "Diff: removed"
    },
    "state-removed-text": {
      "$value": "{color.red.300}"
    },
    "state-info": {
      "$value": "{color.blue.900}"
    },
    "state-info-text": {
      "$value": "{color.blue.300}"
    },
    "ref-1": {
      "$value": "{color.blue.300}",
      "$description": "Formula reference 1 (solid border)"
    },
    "ref-2": {
      "$value": "{color.violet.300}",
      "$description": "Formula reference 2 (dashed border)"
    },
    "ref-3": {
      "$value": "{color.amber.300}",
      "$description": "Formula reference 3 (dotted border)"
    },
    "ref-4": {
      "$value": "{color.teal.300}",
      "$description": "Formula reference 4 (double border)"
    },
    "ref-1-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.5843,
          0.7333,
          0.9059
        ],
        "alpha": 0.16,
        "hex": "#95bbe7"
      }
    },
    "ref-2-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.749,
          0.6706,
          0.902
        ],
        "alpha": 0.16,
        "hex": "#bfabe6"
      }
    },
    "ref-3-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8392,
          0.7216,
          0.5647
        ],
        "alpha": 0.16,
        "hex": "#d6b890"
      }
    },
    "ref-4-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4824,
          0.7804,
          0.7765
        ],
        "alpha": 0.16,
        "hex": "#7bc7c6"
      }
    },
    "syntax-key": {
      "$value": "{color.blue.300}",
      "$description": "JSON/YAML keys, Markdown link targets"
    },
    "syntax-string": {
      "$value": "{color.green.300}",
      "$description": "Strings"
    },
    "syntax-number": {
      "$value": "{color.amber.300}",
      "$description": "Numbers"
    },
    "syntax-literal": {
      "$value": "{color.violet.300}",
      "$description": "true / false / null, function names"
    },
    "syntax-punct": {
      "$value": "{color.ink.150}",
      "$description": "Punctuation, comments, Markdown markers"
    }
  }
}
