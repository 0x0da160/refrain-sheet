{
  "name": "refrain-sheet",
  "version": "0.8.13",
  "description": "A format-preserving CSV editor that runs directly from a local HTML file.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "0x0da160",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:hosted": "vite --mode hosted",
    "build": "tsc --noEmit && vite build",
    "build:hosted": "tsc --noEmit && vite build --mode hosted",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:sqljs": "node scripts/embed-sqljs.mjs",
    "build:landing": "node scripts/build-landing.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:dist:hosted": "node scripts/check-dist.mjs --dir dist-hosted --mode hosted",
    "ui:check": "node scripts/ui-check.mjs",
    "capture:landing-screenshots": "node scripts/capture-landing-screenshots.mjs",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "bench": "vitest bench --run",
    "test:rust": "cargo test --manifest-path wasm/Cargo.toml",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:versions": "node scripts/check-versions.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:knowledge": "node scripts/check-knowledge-frontmatter.mjs",
    "check:knip": "node scripts/check-knip.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "encoding-japanese": "^2.2.0",
    "lucide": "1.28.0",
    "sql.js": "1.14.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/encoding-japanese": "^2.2.1",
    "@types/sql.js": "1.4.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "fast-check": "^3.23.2",
    "jsdom": "^26.0.0",
    "knip": "6.37.0",
    "playwright": "1.62.1",
    "prettier": "^3.4.2",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
