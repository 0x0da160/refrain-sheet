{
  "$description": "Theme \"dark\" — semantic colours. Generated by tools/build.mjs.",
  "color": {
    "$type": "color",
    "chrome-bg": {
      "$value": "{color.ink.900}",
      "$description": "App background behind bars and panels"
    },
    "chrome-surface": {
      "$value": "{color.ink.800}",
      "$description": "Bars, docked panels, cards"
    },
    "chrome-raised": {
      "$value": "{color.ink.700}",
      "$description": "Menus, popovers, dialogs, anything floating"
    },
