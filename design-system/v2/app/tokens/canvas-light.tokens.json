{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Canvas colours for the \"light\" app theme.",
  "canvas": {
    "$type": "color",
    "canvas-bg": {
      "$value": "{color.paper.0}",
      "$description": "Cell background; also source-editor background"
    },
    "canvas-row-alt": {
      "$value": "{color.paper.50}",
      "$description": "Optional banded rows (off by default)"
    },
    "canvas-header-bg": {
      "$value": "{color.paper.50}",
      "$description": "Row and column headers"
    },
    "canvas-header-text": {
      "$value": "{color.ink.500}"
    },
    "canvas-header-selected-bg": {
      "$value": "{color.green.100}",
      "$description": "Header of a selected row/column"
    },
    "canvas-header-selected-text": {
      "$value": "{color.green.800}"
    },
    "canvas-grid": {
      "$value": "{color.paper.200}",
      "$description": "Grid lines"
    },
    "canvas-grid-strong": {
      "$value": "{color.paper.300}",
      "$description": "Header edge lines"
    },
    "canvas-frozen-divider": {
      "$value": "{color.ink.300}",
      "$description": "Line after frozen rows/columns"
    },
    "canvas-text": {
      "$value": "{color.ink.900}",
      "$description": "Cell text in the default style"
    },
    "canvas-text-muted": {
      "$value": "{color.ink.500}",
      "$description": "Placeholder and secondary text inside the canvas"
    },
    "canvas-selection": {
      "$value": "{color.green.50}",
      "$description": "Solid selection fill (single items)"
    },
    "canvas-range-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0784,
          0.498,
          0.2627
        ],
        "alpha": 0.12,
        "hex": "#147f43"
      },
      "$description": "Selected range: translucent, so user cell fills stay visible"
    },
    "canvas-selection-border": {
      "$value": "{color.green.600}",
      "$description": "Active cell border, range edge, fill handle"
    },
    "canvas-focus-ring": {
      "$value": "{color.green.600}",
      "$description": "Focus outline drawn on the canvas"
    },
    "canvas-find-match": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8392,
          0.7216,
          0.5647
        ],
        "alpha": 0.55,
        "hex": "#d6b890"
      },
      "$description": "Find: every match"
    },
    "canvas-find-current": {
      "$value": "{color.amber.600}",
      "$description": "Find: outline of the current match"
    },
    "canvas-error-text": {
      "$value": "{color.red.700}",
      "$description": "Formula error values (#DIV/0! etc.), bold"
    },
    "canvas-formula-text": {
      "$value": "{color.green.700}",
      "$description": "Text of a cell whose value is computed"
    },
    "canvas-formula-mark": {
      "$value": "{color.green.500}",
      "$description": "Formula corner mark (bottom-left)"
    },
    "canvas-edited-mark": {
      "$value": "{color.amber.600}",
      "$description": "Edited-cell change bar (inline-start edge)"
    },
    "canvas-comment-mark": {
      "$value": "{color.blue.600}",
      "$description": "Comment corner mark (top-right)"
    },
    "state-added": {
      "$value": "{color.green.100}",
      "$description": "Diff: added"
    },
    "state-added-text": {
      "$value": "{color.green.800}"
    },
    "state-modified": {
      "$value": "{color.amber.100}",
      "$description": "Diff / unsaved edit: modified"
    },
    "state-modified-text": {
      "$value": "{color.amber.900}"
    },
    "state-removed": {
      "$value": "{color.red.100}",
      "$description": "Diff: removed"
    },
    "state-removed-text": {
      "$value": "{color.red.900}"
    },
    "state-info": {
      "$value": "{color.blue.100}"
    },
    "state-info-text": {
      "$value": "{color.blue.900}"
    },
    "ref-1": {
      "$value": "{color.blue.600}",
      "$description": "Formula reference 1 (solid border)"
    },
    "ref-2": {
      "$value": "{color.violet.600}",
      "$description": "Formula reference 2 (dashed border)"
    },
    "ref-3": {
      "$value": "{color.amber.600}",
      "$description": "Formula reference 3 (dotted border)"
    },
    "ref-4": {
      "$value": "{color.teal.600}",
      "$description": "Formula reference 4 (double border)"
    },
    "ref-1-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1765,
          0.4549,
          0.7373
        ],
        "alpha": 0.12,
        "hex": "#2d74bc"
      }
    },
    "ref-2-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.502,
          0.349,
          0.7333
        ],
        "alpha": 0.12,
        "hex": "#8059bb"
      }
    },
    "ref-3-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.651,
          0.4627,
          0.1647
        ],
        "alpha": 0.12,
        "hex": "#a6762a"
      }
    },
    "ref-4-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0745,
          0.5098,
          0.5098
        ],
        "alpha": 0.12,
        "hex": "#138282"
      }
    },
    "syntax-key": {
      "$value": "{color.blue.700}",
      "$description": "JSON/YAML keys, Markdown link targets"
    },
    "syntax-string": {
      "$value": "{color.green.700}",
      "$description": "Strings"
    },
    "syntax-number": {
      "$value": "{color.amber.700}",
      "$description": "Numbers"
    },
    "syntax-literal": {
      "$value": "{color.violet.700}",
      "$description": "true / false / null, function names"
    },
    "syntax-punct": {
      "$value": "{color.ink.500}",
      "$description": "Punctuation, comments, Markdown markers"
    }
  }
}
