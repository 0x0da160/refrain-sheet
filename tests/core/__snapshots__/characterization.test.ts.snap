exports[`recalculation corpus > evaluates every non-volatile function example identically 1`] = `
{
  "ABS =ABS(A1)": "0",
  "AND =AND(A1>0, B1<10)": "FALSE",
  "AVERAGE =AVERAGE(B1:B20)": "4",
  "AVERAGEIF =AVERAGEIF(A1:A10, ">10", B1:B10)": "3.5",
  "AVERAGEIFS =AVERAGEIFS(C1:C10, A1:A10, ">10", B1:B10, "yes")": "#DIV/0!",
  "CONCAT =CONCAT(A1:A3)": "071",
  "COUNT =COUNT(A1:A10)": "10",
  "COUNTA =COUNTA(A1:A10)": "10",
  "COUNTBLANK =COUNTBLANK(A1:A10)": "0",
  "COUNTIF =COUNTIF(A1:A10, ">10")": "1",
  "COUNTIFS =COUNTIFS(A1:A10, ">10", B1:B10, "yes")": "0",
  "DATE =DATE(2026, 7, 25)": "46228",
  "DATEDIF =DATEDIF(A1, B1, "Y")": "#NUM!",
  "DAY =DAY(A1)": "30",
  "FILTER =FILTER(A1:C10, B1:B10>5)": "#CALC!",
  "IF =IF(A1>10, "big", "small")": "small",
  "IFERROR =IFERROR(A1/B1, 0)": "0",
  "INDEX =INDEX(A1:C10, 2, 3)": "Banana",
  "LEFT =LEFT(A1, 3)": "0",
  "LEN =LEN(A1)": "1",
  "LOWER =LOWER(A1)": "0",
  "MATCH =MATCH(A1, B1:B10, 0)": "#N/A",
  "MAX =MAX(A1:A10)": "11",
  "MEDIAN =MEDIAN(A1:A10)": "5.5",
  "MID =MID(A1, 2, 3)": "",
  "MIN =MIN(A1:A10)": "0",
  "MOD =MOD(A1, 3)": "0",
  "MODE.SNGL =MODE.SNGL(A1:A10)": "#N/A",
  "MONTH =MONTH(A1)": "12",
  "NOT =NOT(A1>10)": "TRUE",
  "OR =OR(A1>0, B1<10)": "TRUE",
  "RANK.EQ =RANK.EQ(A1, A1:A10)": "10",
  "REPLACE =REPLACE(A1, 1, 3, "abc")": "abc",
  "RIGHT =RIGHT(A1, 3)": "0",
  "ROUND =ROUND(A1, 2)": "0",
  "ROUNDDOWN =ROUNDDOWN(A1, 2)": "0",
  "ROUNDUP =ROUNDUP(A1, 2)": "0",
  "SEQUENCE =SEQUENCE(5, 2, 1, 1)": "1",
  "SORT =SORT(A1:C10, 2, FALSE)": "#SPILL!",
  "STDEV.P =STDEV.P(A1:A10)": "3.774917217635375",
  "STDEV.S =STDEV.S(A1:A10)": "3.9791121287711073",
  "SUBSTITUTE =SUBSTITUTE(A1, "-", "/")": "0",
  "SUM =SUM(A1:A10)": "55",
  "SUMIF =SUMIF(A1:A10, ">10", B1:B10)": "3.5",
  "SUMIFS =SUMIFS(C1:C10, A1:A10, ">10", B1:B10, "yes")": "0",
  "TEXT =TEXT(1234.5, "#,##0.00")": "1,234.50",
  "TEXTJOIN =TEXTJOIN(", ", TRUE, A1:A10)": "0, 7, 1, 8, 2, 9, 3, 10, 4, 11",
  "TRIM =TRIM(A1)": "0",
  "UNIQUE =UNIQUE(A1:A10)": "#SPILL!",
  "UPPER =UPPER(A1)": "0",
  "VLOOKUP =VLOOKUP(A1, B1:D10, 3, FALSE)": "#N/A",
  "XLOOKUP =XLOOKUP(A1, B1:B10, C1:C10, "none")": "none",
  "YEAR =YEAR(A1)": "1899",
}
`;
