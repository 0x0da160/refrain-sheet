// SPDX-License-Identifier: MIT
//
// Non-destructive unused-code analysis (Knip). This config does not delete
// anything; it only tells `npx knip` what to look at. Run it with:
//
//   npx knip
//
// See docs/knip-baseline.md for the classified baseline report and the
// reasoning behind every ignore below.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // The landing site is a separate, plain-JS static site (see
    // eslint.config.js's comment on src/landing/) built by
    // scripts/build-landing.mjs. Its template.html loads main.js and
    // consent.js via plain <script src="…"> tags — not ES imports — so
    // Knip can't reach them by following imports and each needs its own
    // entry. src/landing/i18n.js needs no entry: it's already reachable as
    // a real `import` from scripts/build-landing.mjs (itself an entry
    // below).
    "src/landing/main.js",
    "src/landing/consent.js",
    // Build/verification tooling — each script is invoked directly by
    // package.json, not imported, so each is its own entry.
    "scripts/*.mjs",
    // Test and benchmark files are entry points by nature: Vitest imports
    // them, nothing in src/ imports them back.
    "tests/**/*.ts",
    "bench/**/*.ts",
    // src/main.ts and vite.config.ts are intentionally NOT listed: Knip's
    // built-in Vite plugin discovers src/main.ts from index.html's <script>
    // tag, and discovers vite.config.ts itself as the project's build
    // config — listing them again was flagged as a redundant entry pattern.
  ],
  "project": ["src/**/*.ts", "src/landing/**/*.js", "scripts/**/*.mjs", "tests/**/*.ts", "bench/**/*.ts"],
  "ignore": [
    // Generated: embedded WASM + glue, regenerated by `npm run build:wasm`
    // and `npm run build:sqljs`. Never hand-edited; see .gitattributes
    // (linguist-generated=true) and eslint.config.js.
    "src/wasm-gen/**",
    // design-system/, dist/, dist-hosted/, and landing/ (the build output
    // directory, not src/landing/) need no entry here: none of them match
    // the "project" globs above, so Knip already never looks inside them.
  ],
  "ignoreDependencies": [
    // Used only via CSS `@import 'tailwindcss/theme.css'` /
    // 'tailwindcss/utilities.css' in src/styles.css (see
    // docs/architecture.md's "Styling stays hand-written CSS" section).
    // Knip's project globs above don't include *.css, so it never sees
    // this real usage and reports the package as unused.
    "tailwindcss",
  ],
  "vitest": {
    "config": ["vite.config.ts"],
  },
}
